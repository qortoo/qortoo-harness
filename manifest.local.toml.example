# Example local overlay for qortoo-harness
# Schema and merge rules: docs/repository-manifest.md (Python 3.11+).
# Copy to manifest.local.toml to customize local paths or add private/experimental repositories.
# manifest.local.toml is gitignored and will never be committed.

# [workspace]
# root = "/custom/path/to/qortoo/workspace"

# Example: Override repository path or use SSH remote protocol
# [repositories.qortoo-rs]
# remote = "git@github.com:qortoo/qortoo-rs.git"
# path = "custom-rs-path"

# Example: Include unreleased, local-only, or private repositories
# [repositories.internal-reference]
# path = "internal-reference"
# role = "reference"
# tier = "internal"
# tools = ["go", "make"]
# agents_md = "unmanaged"
# remote is optional for internal, local-only reference repositories.

